# ==============================================================================
# KARTHIKEYAN TEXTILES - ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to '.env' for local development.
# IMPORTANT: Never commit '.env' containing real secrets to version control.
# Frontend-exposed variables must start with 'VITE_'.

# ------------------------------------------------------------------------------
# 1. Supabase Client Configuration (Frontend Safe)
# ------------------------------------------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key-here

# ------------------------------------------------------------------------------
# 2. Public Site Configuration
# ------------------------------------------------------------------------------
VITE_PUBLIC_SITE_URL=http://localhost:5173
VITE_COMPANY_PHONE=+919842406591
VITE_COMPANY_EMAIL=karthikeyantextiles18@gmail.com
VITE_WHATSAPP_NUMBER=919842406591

# ------------------------------------------------------------------------------
# 3. Server-Side / Edge Functions Configuration (DO NOT EXPOSE TO FRONTEND)
# ------------------------------------------------------------------------------
# Used in Supabase Edge Functions or backend API runners for secure operations
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-never-expose-to-browser
RESEND_API_KEY=re_your_resend_api_key_here
TRANSACTIONAL_EMAIL_SENDER=orders@your-verified-domain.com
NOTIFICATION_RECIPIENT_EMAIL=karthikeyantextiles18@gmail.com
